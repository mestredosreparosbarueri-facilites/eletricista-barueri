TA--\u003e\n  \u003csection class=\"mrt-section\"\u003e\n    \u003cdiv class=\"mrt-container\"\u003e\n      \u003cdiv class=\"mrt-cta\"\u003e\n        \u003ch2\u003ePrecisa de atendimento ou laudo técnico em Barueri?\u003c/h2\u003e\n        \u003cp\u003eConte com mais de 15 anos de mercado e responsabilidade técnica garantida por um Engenheiro Eletricista. Segurança, norma técnica e serviço com garantia.\u003c/p\u003e\n        \u003ca class=\"mrt-btn\" href=\"https://wa.me/5511918390430?text=Ol%C3%A1%2C%20preciso%20de%20atendimento%20t%C3%A9cnico%20em%20Barueri.\" onclick=\"gtag('event','conversion',{'send_to':'AW-17918599259/42knCLy_j68cENvAoOBC'});\" rel=\"noopener\" target=\"_blank\"\u003e\n          ⚡ Falar com o Mestre no WhatsApp\n        \u003c/a\u003e\n      \u003c/div\u003e\n    \u003c/div\u003e\n  \u003c/section\u003e\n\n\u003c/div\u003e\n\n\u003cscript type=\"application/ld+json\"\u003e\n{\n  \"@context\": \"https://schema.org\",\n  \"@type\": \"Person\",\n  \"name\": \"Paulo Henrique Valadão Santos\",\n  \"jobTitle\": \"Engenheiro Eletricista — Responsável Técnico\",\n  \"worksFor\": {\n    \"@type\": \"Organization\",\n    \"@id\": \"https://www.mestredosreparos.app.br/#empresa\",\n    \"name\": \"Mestre dos Reparos Manutenção & Limpeza\",\n    \"url\": \"https://www.mestredosreparos.app.br/\"\n  },\n  \"alumniOf\": [\n    {\n      \"@type\": \"CollegeOrUniversity\",\n      \"name\": \"Universidade Federal do Rio de Janeiro (UFRJ)\"\n    },\n    {\n      \"@type\": \"EducationalOrganization\",\n      \"name\": \"SENAI\"\n    }\n  ],\n  \"hasCredential\": [\n    {\n      \"@type\": \"EducationalOccupationalCredential\",\n      \"credentialCategory\": \"degree\",\n      \"name\": \"Bacharel em Engenharia Elétrica - UFRJ\"\n    },\n    {\n      \"@type\": \"EducationalOccupationalCredential\",\n      \"credentialCategory\": \"certificate\",\n      \"name\": \"Técnico em Eletrotécnica - SENAI\"\n    },\n    {\n      \"@type\": \"EducationalOccupationalCrede