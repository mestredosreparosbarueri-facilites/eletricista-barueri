8px 22px rgba(26,42,71,0.06); }\n  .mrt-cert h3 { margin-bottom: 4px; }\n  .mrt-cert span.mrt-org { display: block; font-size: 14px; color: #f4aa1c; font-weight: 700; margin-bottom: 6px; }\n  .mrt-cert p { font-size: 15px; margin: 0; }\n\n  .mrt-list { list-style: none; padding: 0; margin: 0; }\n  .mrt-list li { padding: 12px 0; border-bottom: 1px solid #eef1f6; font-size: 16px; color: #3a4a63; }\n  .mrt-list li:last-child { border-bottom: none; }\n\n  .mrt-exp { background: linear-gradient(180deg, #264a78 0%, #223f67 100%); border-radius: 22px; padding: 30px; }\n  .mrt-exp h2, .mrt-exp p { color: #fff; }\n  .mrt-exp p { color: #dce6f5; }\n  .mrt-exp ul { list-style: none; padding: 0; margin: 16px 0 0; }\n  .mrt-exp ul li { color: #e9f0fb; padding: 10px 0; border-bottom: 1px solid rgba(255,255,255,0.12); }\n  .mrt-exp ul li:last-child { border-bottom: none; }\n\n  .mrt-mosaic { display: grid; grid-template-columns: repeat(auto-fit, minmax(180px, 1fr)); gap: 14px; margin-top: 18px; }\n  .mrt-mosaic img { width: 100%; height: 220px; object-fit: cover; border-radius: 14px; box-shadow: 0 8px 22px rgba(26,42,71,0.12); background: #e9edf3; }\n  .mrt-mosaic figure { margin: 0; }\n  .mrt-mosaic figcaption { font-size: 13px; color: #7e8aa0; margin-top: 8px; text-align: center; }\n\n  .mrt-cta { background: #264a78; border-radius: 24px; padding: 34px 24px; text-align: center; margin-top: 30px; }\n  .mrt-cta h2, .mrt-cta p { color: #fff; }\n  .mrt-cta p { color: #dce6f5; }\n  .mrt-btn { display: inline-flex; align-items: center; justify-content: center; gap: 10px; background: #25D366; color: #fff !important; border-radius: 14px; font-weight: 800; font-size: 18px; padding: 16px 30px; text-decoration: none; margin-top: 8px; box-shadow: 0 10px 24px rgba(37,211,102,0.30); }\n\u003c/style\u003e\n\n\n\n\u003cnav class=\"mr-trilha\" aria-label=\"Você está em\" style=\"font:13px/1.4 Arial,sans-serif;color:#555;margin:0 0 12px;padding:8px 2px\"\u003e\u003ca href=\"https://www.mestredosreparos.app.br/p/mestre-dos-reparos-manutencao-reparos.html?m=1\" style=\"color:#0b2a4a;text-decoration:none\"\u003eInício\u003c/a\u003e \u003cspan aria-hidden=\"true\"\u003e›\u003c/span\u003e \u003ca href=\"https://www.mestredosreparos.app.br/p/eletricista-em-barueri.html?m=1\" style=\"color:#0b2a4a;text-decoration:none\"\u003eEletricista em Barueri\u003c/a\u003e \u003cspan aria-hidden=\"true\"\u003e›\u003c/span\u003e \u003cspan aria-current=\"page\"\u003eResponsabilidade Técnica: Certificações e Registros\u003c/span\u003e\u003c/nav\u003e\n\u003csection style=\"padding: 50px 0px;\"\u003e\n\u003cdiv class=\"mrt-wrap\"\u003e\n  \n  \n  \u003c!--HERO--\u003e\n  \u003csection class=\"mrt-hero\"\u003e\n   \n    \u003cdiv class=\"mrt-container\"\u003e\n      \u003cspan class=\"mrt-badge\"\u003e🛡️ Responsabilidade Técnica e Segurança\u003c/span\u003e\n      \u003ch1\u003eResponsabilidade Técnica e Segurança: Nossas Certificações e Registros Profissionais\u003c/h1\u003e\u003cdiv class=\"mr-cta-topo\" style=\"display:flex;flex-wrap:wrap;gap:10px;margin:14px 0 18px\"\u003e\u003ca href=\"https://wa.me/5511918390430?text=Ol%C3%A1%2C%20preciso%20de%20um%20or%C3%A7amento.\" style=\"background:#25d366;color:#fff;font:700 16px Arial,sans-serif;padding:12px 18px;border-radius:10px;text-decoration:none\"\u003e💬 Chamar no WhatsApp\u003c/a\u003e\u003ca href=\"tel:+5511918390430\" style=\"background:#ffb300;color:#0b2a4a;font:700 16px Arial,sans-serif;padding:12px 18px;border-radius:10px;text-decoration:none\"\u003e📞 Ligar agora\u003c/a\u003e\u003c/div\u003e\n      \u003cp\u003eNa Mestre dos Reparos, segurança elétrica não é um argumento comercial — é norma técnica cumprida à risca, com responsável técnico formado em Engenharia Elétrica.\u003c/p\u003e\u003cp class=\"mr-link-principal\" style=\"font-size:17px;line-height:1.6;background:#fff5e0;color:#222;border-left:5px solid #ffb300;padding:14px 18px;border-radius:10px;margin:18px 0\"\u003ePrecisa resolver isso com segurança? Conheça o serviço de \u003ca href=\"https://www.mestredosreparos.app.br/p/eletricista-em-barueri.html?m=1\" style=\"color:#0b2a4a;font-weight:700\"\u003eeletricista em Barueri\u003c/a\u003e do Mestre dos Reparos, com plantão 24 horas, nota fiscal e garantia de 90 dias.\u003c/p\u003e\n    \u003c/div\u003e\n  \u003c/section\u003e\n\n  \u003c!--ABERTURA / E-E-A-T--\u003e\n  \u003csection class=\"mrt-section\"\u003e\n    \u003cdiv class=\"mrt-container\"\u003e\n      \u003cdiv class=\"mrt-card mrt-accent\"\u003e\n        \u003cp\u003eTodo serviço residencial, comercial e empresarial executado em \u003cstrong\u003eBarueri, Alphaville e região\u003c/strong\u003e conta com a supervisão e a responsabilidade de um \u003cstrong\u003eEngenheiro Eletricista formado pela UFRJ\u003c/strong\u003e, garantindo a emissão de \u003cstrong\u003elaudos e ART\u003c/strong\u003e e a conformidade com as normas técnicas vigentes, incluindo a \u003cstrong\u003eNBR 5410\u003c/strong\u003e e as regras da concessionária (Enel).\u003c/p\u003e\n        \u003cp style=\"margin-bottom: 0px;\"\u003eAbaixo documentamos a grade de qualificações e treinamentos oficiais que atestam nossa capacidade técnica e prática em campo.\u003c/p\u003e\n      \u003c/div\u003e\n    \u003c/div\u003e\n  \u003c/section\u003e\n\n  \u003c!--FORMAÇÃO PRINCIPAL--\u003e\n  \u003csection class=\"mrt-section\"\u003e\n    \u003cdiv class=\"mrt-container\"\u003e\n      \u003cspan class=\"mrt-tag\"\u003eFORMAÇÃO ACADÊMICA\u003c/span\u003e\n      \u003ch2\u003eEngenharia e base técnica de alto nível\u003c/h2\u003e\n      \u003cdiv class=\"mrt-grid mrt-grid-2\"\u003e\n        \u003cdiv class=\"mrt-cert\"\u003e\n          \u003cspan class=\"mrt-org\"\u003eUFRJ — Escola Politécnica\u003c/span\u003e\n          \u003ch3\u003eEngenheiro Eletricista\u003c/h3\u003e\n          \u003cp\u003eBacharelado em Engenharia Elétrica pela Universidade Federal do Rio de Janeiro. Habilitado para emissão de ART e laudos técnicos.\u003c/p\u003e\n        \u003c/div\u003e\n        \u003cdiv class=\"mrt-cert\"\u003e\n          \u003cspan class=\"mrt-org\"\u003eSENAI\u003c/span\u003e\n          \u003ch3\u003eTécnico em Eletrotécnica\u003c/h3\u003e\n          \u003cp\u003eFormação técnica industrial completa (1.656h), base prática em instalações elétricas prediais e residenciais.\u003c/p\u003e\n        \u003c/div\u003e\n        \u003cdiv class=\"mrt-cert\"\u003e\n          \u003cspan class=\"mrt-org\"\u003eSENAI\u003c/span\u003e\n          \u003ch3\u003eTécnico em Refrigeração\u003c/h3\u003e\n          \u003cp\u003eQualificação técnica complementar para sistemas de climatização e refrigeração.\u003c/p\u003e\n        \u003c/div\u003e\n        \u003cdiv class=\"mrt-cert\"\u003e\n          \u003cspan class=\"mrt-org\"\u003eSENAI\u003c/span\u003e\n          \u003ch3\u003eComandos Elétricos Industriais\u003c/h3\u003e\n          \u003cp\u003eComandos elétricos industriais e fechamento de motores — montagem e diagnóstico de painéis.\u003c/p\u003e\n        \u003c/div\u003e\n      \u003c/div\u003e\n    \u003c/div\u003e\n  \u003c/section\u003e\n\n  \u003c!--SEGURANÇA / NRs--\u003e\n  \u003csection class=\"mrt-section\"\u003e\n    \u003cdiv class=\"mrt-container\"\u003e\n      \u003cspan class=\"mrt-tag\"\u003eSEGURANÇA DO TRABALHO\u003c/span\u003e\n      \u003ch2\u003eNormas Regulamentadoras (NRs)\u003c/h2\u003e\n      \u003cdiv class=\"mrt-card\"\u003e\n        \u003cul class=\"mrt-list\"\u003e\n          \u003cli\u003e\u003cstrong\u003eNR-10 — Segurança em Instalações e Serviços em Eletricidade.\u003c/strong\u003e Formação básica (carga horária de 280h).\u003c/li\u003e\n          \u003cli\u003e\u003cstrong\u003eNR-10 SEP — Sistema Elétrico de Potência.\u003c/strong\u003e Capacitação avançada para trabalho em instalações energizadas.\u003c/li\u003e\n          \u003cli\u003e\u003cstrong\u003eNR-12 — Segurança em Máquinas e Equipamentos.\u003c/strong\u003e\u003c/li\u003e\n          \u003cli\u003e\u003cstrong\u003eNR-6 — Utilização de Equipamentos de Proteção Individual (EPI).\u003c/strong\u003e\u003c/li\u003e\n          \u003cli\u003e\u003cstrong\u003eNR-33 — Segurança em Espaço Confinado.\u003c/strong\u003e Formação para trabalho em espaços confinados.\u003c/li\u003e\n        \u003c/ul\u003e\n      \u003c/div\u003e\n    \u003c/div\u003e\n  \u003c/section\u003e\n\n  \u003c!--GESTÃO E EXPERIÊNCIA--\u003e\n  \u003csection class=\"mrt-section\"\u003e\n    \u003cdiv class=\"mrt-container\"\u003e\n      \u003cdiv class=\"mrt-exp\"\u003e\n        \u003cspan class=\"mrt-tag\" style=\"background: rgba(255, 255, 255, 0.12); color: #ffd27a;\"\u003eEXPERIÊNCIA EM CAMPO\u003c/span\u003e\n        \u003ch2\u003eMais de 15 anos em manutenção e gestão de operações\u003c/h2\u003e\n        \u003cp\u003eExperiência consolidada liderando equipes multidisciplinares de manutenção em operações corporativas críticas — engenharia predial, elétrica, ar-condicionado e mecânica em grandes contratos de facilities:\u003c/p\u003e\n        \u003cul\u003e\n          \u003cli\u003e\u003cstrong\u003eGerência de manutenção — contrato Bradesco, Cidade de Deus\u003c/strong\u003e (Grupo GPS / In-Haus Industrial). Liderança de equipe com \u003cstrong\u003emais de 300 colaboradores\u003c/strong\u003e nas disciplinas de manutenção \u003cstrong\u003ecivil, elétrica, ar-condicionado e mecânica\u003c/strong\u003e, em um dos maiores campi corporativos do país.\u003c/li\u003e\n          \u003cli\u003eCoordenação regional de contratos e gestão de equipes técnicas multidisciplinares (Onet Brasil).\u003c/li\u003e\n          \u003cli\u003eCoordenação de operações e manutenção em shoppings e contratos corporativos (Shopping SP Market, Brasanitas, Vivante).\u003c/li\u003e\n          \u003cli\u003eGestão de utilidades, SLAs e manutenção de unidades hospitalares e comerciais.\u003c/li\u003e\n        \u003c/ul\u003e\n      \u003c/div\u003e\n    \u003c/div\u003e\n  \u003c/section\u003e\n\n  \u003c!--GESTÃO COMPLEMENTAR--\u003e\n  \u003csection class=\"mrt-section\"\u003e\n    \u003cdiv class=\"mrt-container\"\u003e\n      \u003cspan class=\"mrt-tag\"\u003eFORMAÇÃO COMPLEMENTAR\u003c/span\u003e\n      \u003ch2\u003eGestão técnica e de projetos\u003c/h2\u003e\n      \u003cdiv class=\"mrt-grid mrt-grid-3\"\u003e\n        \u003cdiv class=\"mrt-cert\"\u003e\n          \u003cspan class=\"mrt-org\"\u003eFGV\u003c/span\u003e\n          \u003ch3\u003eGerenciamento e Identificação de Riscos em Projetos\u003c/h3\u003e\n          \u003cp\u003eAnálise e mitigação de riscos aplicada a projetos técnicos.\u003c/p\u003e\n        \u003c/div\u003e\n        \u003cdiv class=\"mrt-cert\"\u003e\n          \u003cspan class=\"mrt-org\"\u003eFundação Bradesco\u003c/span\u003e\n          \u003ch3\u003eEstratégia de Negócios\u003c/h3\u003e\n          \u003cp\u003ePlanejamento e gestão estratégica de operações.\u003c/p\u003e\n        \u003c/div\u003e\n        \u003cdiv class=\"mrt-cert\"\u003e\n          \u003cspan class=\"mrt-org\"\u003eFIA\u003c/span\u003e\n          \u003ch3\u003eDesenvolvimento de Negócios e Liderança\u003c/h3\u003e\n          \u003cp\u003eLiderança de equipes e desenvolvimento operacional.\u003c/p\u003e\n        \u003c/div\u003e\n      \u003c/div\u003e\n    \u003c/div\u003e\n  \u003c/section\u003e\n\n  \u003c!--MOSAICO DE CERTIFICADOS--\u003e\n  \u003csection class=\"mrt-section\"\u003e\n    \u003cdiv class=\"mrt-container\"\u003e\n      \u003cspan class=\"mrt-tag\"\u003eDOCUMENTAÇÃO\u003c/span\u003e\n      \u003ch2\u003eDiplomas e certificados\u003c/h2\u003e\n      \u003cp\u003eDocumentação técnica que comprova a qualificação por trás de cada atendimento da Mestre dos Reparos.\u003c/p\u003e\n      \u003cdiv class=\"mrt-mosaic\"\u003e\n        \u003c!--SUBSTITUA os src abaixo pelos links das fotos dos seus certificados (hospedados no Blogger). Mantenha o alt descritivo.--\u003e\n        \u003cfigure\u003e\n          \u003cimg alt=\"Diploma de Engenharia Elétrica pela UFRJ - responsável técnico Mestre dos Reparos\" loading=\"