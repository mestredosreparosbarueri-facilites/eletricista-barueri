:14px 0 0;}\n.mr-aval.rated .mr-aval-estrelas span{cursor:default;}\n.mr-aval.rated .mr-aval-obrigado{display:block;}\n@media(max-width:768px){.mr-aval-titulo{font-size:22px;}.mr-aval-estrelas{font-size:38px;}}\n</style>\n\n<script>\n(function(){\n  var box=document.currentScript.parentNode.querySelector('.mr-aval')||document.querySelector('.mr-aval');\n  if(!box)return;\n  var stars=box.querySelectorAll('.mr-aval-estrelas span'), sel=0, locked=false;\n  var key='mr_aval_'+location.pathname;\n  function paint(n){stars.forEach(function(s){var v=+s.dataset.v;s.innerHTML=v<=n?'\\u2605':'\\u2606';s.classList.toggle('on',v<=n);});}\n  try{var saved=localStorage.getItem(key);if(saved){sel=+saved;locked=true;box.classList.add('rated');paint(sel);}}catch(e){}\n  stars.forEach(function(s){\n    s.addEventListener('mouseenter',function(){if(!locked)paint(+s.dataset.v);});\n    s.addEventListener('click',function(){\n      if(locked)return;\n      sel=+s.dataset.v;locked=true;paint(sel);box.classList.add('rated');\n      try{localStorage.setItem(key,sel);}catch(e){}\n    });\n  });\n  box.querySelector('.mr-aval-estrelas').addEventListener('mouseleave',function(){paint(sel);});\n})();\n</script>\n<script type=\"application/ld+json\">\n{\n  \"@context\": \"https://schema.org\",\n  \"@type\": \"Service\",\n  \"name\": \"Troca de Disjuntores em Barueri\",\n  \"serviceType\": \"Serviços de eletricista\",\n  \"url\": \"https://www.mestredosreparos.app.br/2026/05/trocadedisjuntoreseletrecistaembarueri.html\",\n  \"provider\": {\n    \"@id\": \"https://www.mestredosreparos.app.br/#empresa\"\n  },\n  \"areaServed\": {\n    \"@type\": \"City\",\n    \"name\": \"Barueri\"\n  },\n  \"description\": \"Neste atendimento, o quadro antigo foi aberto, os disjuntores antigos foram retirados e o quadro foi montado de novo com disjuntores novos e organizados.\"\n}\n</script>\n<script type=\"application/ld+json\">\n{\n  \"@context\": \"https://schema.org\",\n  \"@type\": \"BreadcrumbList\",\n  \"