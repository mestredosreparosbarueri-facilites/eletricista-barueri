stre-grid{display:grid;grid-template-columns:1fr;gap:14px;margin:18px 0;}\n@media(min-width:620px){.mestre-grid{grid-template-columns:1fr 1fr;}}\n.mestre-card{background:#fff;border:1px solid #e3e8ee;border-radius:10px;padding:16px;}\n.mestre-card h3{margin-top:0;font-size:1.05em;}\n.mestre-urgencia{background:#fff4e5;border:1px solid var(--amarelo);border-radius:8px;padding:14px 16px;margin:18px 0;font-size:0.95em;}\n.mdr-carrossel-wrap{position:relative;overflow:hidden;margin:18px 0;padding:10px 0;background:#fff;border:1px solid #e3e8ee;border-radius:12px;}\n.mdr-carrossel-wrap::before,.mdr-carrossel-wrap::after{content:\"\";position:absolute;top:0;bottom:0;width:40px;z-index:2;pointer-events:none;}\n.mdr-carrossel-wrap::before{left:0;background:linear-gradient(90deg,#fff,rgba(255,255,255,0));}\n.mdr-carrossel-wrap::after{right:0;background:linear-gradient(270deg,#fff,rgba(255,255,255,0));}\n.mdr-carrossel-track{display:flex;align-items:center;gap:0;width:max-content;animation:mdr-scroll 28s linear infinite;}\n.mdr-carrossel-wrap:hover .mdr-carrossel-track{animation-play-state:paused;}\n.mdr-cliente-card{flex:0 0 auto;width:170px;display:flex;flex-direction:column;align-items:center;justify-content:center;padding:14px 18px;text-align:center;}\n.mdr-cliente-card img{max-width:120px;max-height:42px;object-fit:contain;filter:grayscale(100%);opacity:0.8;transition:filter .2s,opacity .2s;}\n.mdr-cliente-card img:hover{filter:grayscale(0%);opacity:1;}\n.mdr-cliente-card .nome{font-weight:bold;color:var(--azul);font-size:0.95em;}\n.mdr-cliente-card .local{font-size:0.78em;color:#667;margin-top:4px;}\n@keyframes mdr-scroll{0%{transform:translateX(0);}100%{transform:translateX(-50%);}}\n@media(prefers-reduced-motion:reduce){.mdr-carrossel-track{animation:none;}}\n.mdr-stars{color:var(--amarelo);font-size:1.1em;}\n.mdr-review{background:#fff;border:1px solid #e3e8ee;border-radius:10px;padding:14px;margin-bottom:10px;}\n.mdr-review .nome{font-weight:bold;color:var(--azul);font-size:0.92em;}\n.mestre-faq details{background:#fff;border:1px solid #e3e8ee;border-radius:8px;margin-bottom:8px;padding:12px 14px;}\n.mestre-faq summary{font-weight:bold;cursor:pointer;color:var(--azul);}\n.mestre-faq summary::-webkit-details-marker{color:var(--amarelo);}\n.mdr-table{width:100%;border-collapse:collapse;margin:14px 0;font-size:0.92em;}\n.mdr-table th,.mdr-table td{border:1px solid #e3e8ee;padding:8px 10px;text-align:left;}\n.mdr-table th{background:var(--azul);color:#fff;}\n.mdr-author{display:flex;gap:12px;align-items:flex-start;background:#f6f8fb;border-radius:10px;padding:14px;margin:20px 0;}\n.mdr-author .foto{width:56px;height:56px;border-radius:50%;background:var(--azul);color:#fff;display:flex;align-items:center;justify-content:center;font-weight:bold;flex-shrink:0;}\n.mestre-footer{background:var(--azul);color:#dde6f0;border-radius:10px;padding:20px;margin-top:26px;font-size:0.88em;}\n.mestre-footer a{color:var(--amarelo);text-decoration:none;}\n.mdr-bairros{columns:2;column-gap:16px;font-size:0.9em;}\n@media(min-width:620px){.mdr-bairros{columns:3;}}\n.mdr-crumb{font-size:0.82em;color:#667;margin-bottom:10px;}\n.mdr-crumb a{color:var(--azul2);text-decoration:none;}\n\u003c/style\u003e\n\n\u003cnav class=\"mdr-crumb\" aria-label=\"breadcrumb\"\u003e\n\u003ca href=\"https://www.mestredosreparos.app.br/\"\u003eInício\u003c/a\u003e &rsaquo;\n\u003ca href=\"https://www.mestredosreparos.app.br/p/contratos-corporativos-b2b.html?m=1\"\u003eServiços B2B\u003c/a\u003e &rsaquo;\nManutenção Predial para Empresas em Barueri\n\u003c/nav\u003e\n\n\u003csection class=\"mestre-hero\"\u003e\n\u003ch1\u003eManutenção Predial para Empresas e Prédios Corporativos em Barueri\u003c/h1\u003e\n\u003cp\u003eElétrica, hidráulica, ar-condicionado e reformas para empresas, galpões, centros de distribuição e edifícios corporativos em Barueri, Alphaville, Tamboré e região. Um único fornecedor para toda a manutenção predial do seu negócio — com contrato recorrente, visita avulsa ou atendimento emergencial.\u003c/p\u003e\n\u003cdiv class=\"mdr-cta-row\"\u003e\n\u003ca class=\"mdr-btn\" href=\"https://wa.me/5511918390430?text=Ol%C3%A1%2C%20preciso%20de%20manuten%C3%A7%C3%A3o%20predial%20para%20minha%20empresa%20em%20Barueri\"\u003eFalar no WhatsApp agora\u003c/a\u003e\n\u003ca class=\"mdr-btn-outline\" href=\"https://mestre-reparos.base44.app/Agendamento\"\u003eSolicitar visita técnica\u003c/a\u003e\n\u003c/div\u003e\n\u003c/section\u003e\n\n\u003cp\u003eA \u003cstrong\u003eMestre dos Reparos\u003c/strong\u003e presta manutenção predial para empresas de diversos portes em Barueri e região — de centros de distribuição a agências financeiras e indústrias. Atendemos elétrica, hidráulica, ar-condicionado e reformas com uma única equipe, reduzindo o número de fornecedores que sua empresa precisa gerenciar e garantindo um padrão técnico único em todo o imóvel.\u003c/p\u003e\n\n\u003ch2\u003ePor que empresas em Barueri contratam a Mestre dos Reparos\u003c/h2\u003e\n\u003cdiv class=\"mestre-grid\"\u003e\n\u003cdiv class=\"mestre-card\"\u003e\n\u003ch3\u003eUm fornecedor, toda a manutenção\u003c/h3\u003e\n\u003cp\u003eElétrica, hidráulica, ar-condicionado e reformas com a mesma equipe — menos fornecedores para gerenciar e um só ponto de contato para qualquer chamado.\u003c/p\u003e\n\u003c/div\u003e\n\u003cdiv class=\"mestre-card\"\u003e\n\u003ch3\u003eResponsabilidade técnica\u003c/h3\u003e\n\u003cp\u003eServiços executados conforme NBR 5410 e NR-10, com ART/CREA emitida quando o escopo exigir, atendendo às exigências de auditorias e seguradoras.\u003c/p\u003e\n\u003c/div\u003e\n\u003cdiv class=\"mestre-card\"\u003e\n\u003ch3\u003eContrato de manutenção recorrente\u003c/h3\u003e\n\u003cp\u003ePlanos mensais ou trimestrais de manutenção preventiva para reduzir paradas não programadas na operação do seu negócio.\u003c/p\u003e\n\u003c/div\u003e\n\u003cdiv class=\"mestre-card\"\u003e\n\u003ch3\u003eNota fiscal e faturamento\u003c/h3\u003e\n\u003cp\u003eEmissão de nota fiscal para pessoa jurídica, com possibilidade de faturamento mensal consolidado para clientes com contrato recorrente.\u003c/p\u003e\n\u003c/div\u003e\n\u003c/div\u003e\n\n\u003ch2\u003eServiços de manutenção predial para empresas\u003c/h2\u003e\n\u003cul\u003e\n\u003cli\u003e\u003cstrong\u003eElétrica predial\u003c/strong\u003e — manutenção de quadros elétricos, adequação à NR-10, iluminação comercial, nobreaks e geradores, padrão de entrada\u003c/li\u003e\n\u003cli\u003e\u003cstrong\u003eHidráulica\u003c/strong\u003e — reparo de vazamentos, manutenção de caixas d'água, desentupimento, troca de registros e tubulações\u003c/li\u003e\n\u003cli\u003e\u003cstrong\u003eAr-condicionado\u003c/strong\u003e — manutenção preventiva e corretiva de splits e sistemas centrais, limpeza e recarga de gás\u003c/li\u003e\n\u003cli\u003e\u003cstrong\u003eReformas e adequações de espaço\u003c/strong\u003e — drywall, pintura, pequenas obras civis para adequação de layout corporativo\u003c/li\u003e\n\u003cli\u003e\u003cstrong\u003eManutenção geral predial\u003c/strong\u003e — pequenos reparos, troca de peças, ajustes estruturais e de acabamento\u003c/li\u003e\n\u003cli\u003e\u003cstrong\u003eLaudo técnico predial\u003c/strong\u003e — relatório para laudos de seguradora, due diligence e locação comercial\u003c/li\u003e\n\u003c/ul\u003e\n\n\u003cdiv class=\"mestre-urgencia\"\u003e\n\u003cstrong\u003eAtendimento emergencial para empresas:\u003c/strong\u003e vazamento, falha elétrica ou ar-condicionado parado comprometem a operação. Priorizamos chamados corporativos com contrato ativo e atendemos emergências pontuais sujeitas à disponibilidade de agenda.\n\u003c/div\u003e\n\n\u003ch2\u003eSegmentos atendidos\u003c/h2\u003e\n\u003cdiv class=\"mdr-bairros\"\u003e\n\u003cp\u003eCentros de distribuição e armazéns\u003c/p\u003e\n\u003cp\u003eAgências e escritórios financeiros\u003c/p\u003e\n\u003cp\u003eIndústrias e fábricas\u003c/p\u003e\n\u003cp\u003eEmpresas de certificação e inspeção\u003c/p\u003e\n\u003cp\u003eEscritórios corporativos\u003c/p\u003e\n\u003cp\u003eCondomínios empresariais\u003c/p\u003e\n\u003cp\u003eLojas e comércios\u003c/p\u003e\n\u003cp\u003eGalpões logísticos\u003c/p\u003e\n\u003c/div\u003e\n\n\u003ch2\u003eRegião de atendimento corporativo\u003c/h2\u003e\n\u003cp\u003eAtendemos empresas e condomínios comerciais em Barueri (incluindo Alphaville e Tamboré), Carapicuíba, Jandira, Itapevi e Santana de Parnaíba, em um raio de atendimento de aproximadamente 20 km a partir da nossa base operacional.\u003c/p\u003e\n\n\u003ch2\u003eTabela de modalidades de atendimento\u003c/h2\u003e\n\u003ctable class=\"mdr-table\"\u003e\n\u003ctr\u003e\u003cth\u003eModalidade\u003c/th\u003e\u003cth\u003eIndicado para\u003c/th\u003e\u003cth\u003eComo funciona\u003c/th\u003e\u003c/tr\u003e\n\u003ctr\u003e\u003ctd\u003eVisita técnica avulsa\u003c/td\u003e\u003ctd\u003eDemanda pontual ou primeira avaliação\u003c/td\u003e\u003ctd\u003eAgendamento via WhatsApp ou plataforma, orçamento prévio\u003c/td\u003e\u003c/tr\u003e\n\u003ctr\u003e\u003ctd\u003eContrato de manutenção\u003c/td\u003e\u003ctd\u003eEmpresas com rotina de inspeção periódica\u003c/td\u003e\u003ctd\u003ePlano mensal/trimestral com relatório técnico\u003c/td\u003e\u003c/tr\u003e\n\u003ctr\u003e\u003ctd\u003eAtendimento emergencial\u003c/td\u003e\u003ctd\u003eFalha que impacta a operação\u003c/td\u003e\u003ctd\u003ePrioridade para clientes com contrato ativo\u003c/td\u003e\u003c/tr\u003e\n\u003c/table\u003e\n\n\u003ch2\u003eEmpresas que já atendemos em Barueri e região\u003c/h2\u003e\n\u003cdiv class=\"mdr-carrossel-wrap\"\u003e\n\u003cdiv class=\"mdr-carrossel-track\"\u003e\n\u003c!-- bloco 1 --\u003e\n\u003cdiv class=\"mdr-cliente-card\"\u003e\n\u003cimg width=\"300\" height=\"100\" src=\"https://armazena.com.br/wp-content/uploads/2021/09/logo_300.png\" alt=\"Logo Armazena Armazéns Gerais\" loading=\"lazy\" onerror=\"this.style.display='none';this.nextElementSibling.style.display='block';\"\u003e\n\u003cdiv class=\"nome\" style=\"display:none;\"\u003eArmazena Armazéns Gerais\u003c/div\u003e\n\u003cdiv class=\"local\"\u003eItapevi\u003c/div\u003e\n\u003c/div\u003e\n\u003cdiv class=\"mdr-cliente-card\"\u003e\n\u003cdiv class=\"nome\"\u003ePJ Bank\u003c/div\u003e\n\u003cdiv class=\"local\"\u003eBarueri\u003c/div\u003e\n\u003c/div\u003e\n\u003cdiv class=\"mdr-cliente-card\"\u003e\n\u003cimg width=\"144\" height=\"144\" src=\"https://cdn1-www.bureauveritas.com.br/themes/custom/bureauveritasbase/favicon/mstile-144x144.png\" alt=\"Logo Bureau Veritas\" loading=\"lazy\" onerror=\"this.style.display='none';this.nextElementSibling.style.display='block';\"\u003e\n\u003cdiv class=\"nome\" style=\"display:none;\"\u003eBureau Veritas\u003c/div\u003e\n\u003cdiv class=\"local\"\u003eAlphaville, Barueri\u003c/div\u003e\n\u003c/div\u003e\n\u003cdiv class=\"mdr-cliente-card\"\u003e\n\u003cimg width=\"268\" height=\"53\" src=\"https://coca-cola-femsa.com.br/wp-content/uploads/2024/05/logo-femsa-juntos-new-2.svg\" alt=\"Logo Coca-Cola FEMSA\" loading=\"lazy\" onerror=\"this.style.display='none';this.nextElementSibling.style.display='block';\"\u003e\n\u003cdiv class=\"nome\" style=\"display:none;\"\u003eCoca-Cola FEMSA\u003c/div\u003e\n\u003cdiv class=\"local\"\u003eBarueri\u003c/div\u003e\n\u003c/div\u003e\n\u003cdiv class=\"mdr-cliente-card\"\u003e\n\u003cimg width=\"97\" height=\"91\" src=\"https://assets.bradesco/content/dam/portal-bradesco/assets/common/img/bra-logo.png\" alt=\"Logo Bradesco\" loading=\"lazy\" onerror=\"this.style.display='none';this.nextElementSibling.style.display='block';\"\u003e\n\u003cdiv class=\"nome\" style=\"display:none;\"\u003eBradesco\u003c/div\u003e\n\u003cdiv class=\"local\"\u003eAlphaville, Barueri\u003c/div\u003e\n\u003c/div\u003e\n\u003cdiv class=\"mdr-cliente-card\"\u003e\n\u003cimg width=\"120\" height=\"120\" src=\"https://cdn.jsdelivr.net/gh/mestredosreparosbarueri-facilites/eletricista-barueri@40bf5f9ddb5617e502b516738a5c086ee7c4956c/fotos/documentos/logo-itau.webp\" alt=\"Logo Itaú\" loading=\"lazy\" onerror=\"this.style.display='none';this.nextElementSibling.style.display='block';\"\u003e\n\u003cdiv class=\"nome\" style=\"display:none;\"\u003eItaú\u003c/div\u003e\n\u003cdiv class=\"local\"\u003eBarueri\u003c/div\u003e\n\u003c/div\u003e\n\u003c!-- bloco 2 (duplicado para loop contínuo) --\u003e\n\u003cdiv class=\"mdr-cliente-card\"\u003e\n\u003cimg width=\"300\" height=\"100\" src=\"https://armazena.com.br/wp-content/uploads/2021/09/logo_300.png\" alt=\"Logo Armazena Armazéns Gerais\" loading=\"lazy\" onerror=\"this.style.display='none';this.nextElementSibling.style.display='block';\"\u003e\n\u003cdiv class=\"nome\" style=\"display:none;\"\u003eArmazena Armazéns Gerais\u003c/div\u003e\n\u003cdiv class=\"local\"\u003eItapevi\u003c/div\u003e\n\u003c/div\u003e\n\u003cdiv class=\"mdr-cliente-card\"\u003e\n\u003cdiv class=\"nome\"\u003ePJ Bank\u003c/div\u003e\n\u003cdiv class=\"local\"\u003eBarueri\u003c/div\u003e\n\u003c/div\u003e\n\u003cdiv class=\"mdr-cliente-card\"\u003e\n\u003cimg width=\"144\" height=\"144\" src=\"https://cdn1-www.bureauveritas.com.br/themes/custom/bureauveritasbase/favicon/mstile-144x144.png\" alt=\"Logo Bureau Veritas\" loading=\"lazy\" onerror=\"this.style.display='none';this.nextElementSibling.style.display='block';\"\u003e\n\u003cdiv class=\"nome\" style=\"display:none;\"\u003eBureau Veritas\u003c/div\u003e\n\u003cdiv class=\"local\"\u003eAlphaville, Barueri\u003c/div\u003e\n\u003c/div\u003e\n\u003cdiv class=\"mdr-cliente-card\"\u003e\n\u003cimg width=\"268\" height=\"53\" src=\"https://coca-cola-femsa.com.br/wp-content/uploads/2024/05/logo-femsa-juntos-new-2.svg\" alt=\"Logo Coca-Cola FEMSA\" loading=\"lazy\" onerror=\"this.style.display='none';this.nextElementSibling.style.display='block';\"\u003e\n\u003cdiv class=\"nome\" style=\"display:none;\"\u003eCoca-Cola FEMSA\u003c/div\u003e\n\u003cdiv class=\"local\"\u003eBarueri\u003c/div\u003e\n\u003c/div\u003e\n\u003cdiv class=\"mdr-cliente-card\"\u003e\n\u003cimg width=\"97\" height=\"91\" src=\"https://assets.bradesco/content/dam/portal-bradesco/assets/common/img/bra-logo.png\" alt=\"Logo Bradesco\" loading=\"lazy\" onerror=\"this.style.display='none';this.nextElementSibling.style.display='block';\"\u003e\n\u003cdiv class=\"nome\" style=\"display:none;\"\u003eBradesco\u003c/div\u003e\n\u003cdiv class=\"local\"\u003eAlphaville, Barueri\u003c/div\u003e\n\u003c/div\u003e\n\u003cdiv class=\"mdr-cliente-card\"\u003e\n\u003cimg width=\"120\" height=\"120\" src=\"https://cdn.jsdelivr.net/gh/mestredosreparosbarueri-facilites/eletricista-barueri@40bf5f9ddb5617e502b516738a5c086ee7c4956c/fotos/documentos/logo-itau.webp\" alt=\"Logo Itaú\" loading=\"lazy\" onerror=\"this.style.display='none';this.nextElementSibling.style.display='block';\"\u003e\n\u003cdiv class=\"nome\" style=\"display:none;\"\u003eItaú\u003c/div\u003e\n\u003cdiv class=\"local\"\u003eBarueri\u003c/div\u003e\n\u003c/div\u003e\n\u003c/div\u003e\n\u003c/div\u003e\n\u003cp style=\"font-size:0.9em;color:#667;\"\u003eEmpresas de diferentes segmentos — logística, financeiro, certificação e indústria — confiam na Mestre dos Reparos para a manutenção predial de suas unidades em Barueri e região.\u003c/p\u003e\n\n\u003ch2\u003ePerguntas frequentes — manutenção predial para empresas em Barueri\u003c/h2\u003e\n\u003cdiv class=\"mestre-faq\"\u003e\n\u003cdetails\u003e\u003csummary\u003eVocês atendem só elétrica ou fazem manutenção predial completa?\u003c/summary\u003e\u003cp\u003eFazemos manutenção predial completa: elétrica, hidráulica, ar-condicionado e pequenas reformas, com a mesma equipe. A empresa não precisa gerenciar fornecedores diferentes para cada tipo de serviço.\u003c/p\u003e\u003c/details\u003e\n\u003cdetails\u003e\u003csummary\u003eVocês emitem ART para serviços elétricos em prédios comerciais?\u003c/summary\u003e\u003cp\u003eSim. Para serviços que exigem responsabilidade técnica formal, emitimos ART/CREA, atendendo a exigências de auditorias internas, seguradoras e órgãos fiscalizadores.\u003c/p\u003e\u003c/details\u003e\n\u003cdetails\u003e\u003csummary\u003eÉ possível fechar um contrato de manutenção mensal para minha empresa?\u003c/summary\u003e\u003cp\u003eSim, oferecemos planos de manutenção preventiva mensal ou trimestral, cobrindo elétrica, hidráulica e ar-condicionado, com relatório técnico de cada visita.\u003c/p\u003e\u003c/details\u003e\n\u003cdetails\u003e\u003csummary\u003eAtendem emergências fora do horário comercial?\u003c/summary\u003e\u003cp\u003eAtendemos emergências que comprometam a segurança ou a operação do negócio, com prioridade para clientes com contrato ativo. Entre em contato pelo WhatsApp para verificar disponibilidade imediata.\u003c/p\u003e\u003c/details\u003e\n\u003cdetails\u003e\u003csummary\u003eQue tipo de empresa vocês já atenderam em Barueri?\u003c/summary\u003e\u003cp\u003eAtendemos empresas de logística como a Armazena Armazéns Gerais em Itapevi, instituições financeiras como PJ Bank, Bradesco e Itaú em Barueri e Alphaville, empresas de certificação como a Bureau Veritas, e indústrias como a Coca-Cola FEMSA.\u003c/p\u003e\u003c/details\u003e\n\u003cdetails\u003e\u003csummary\u003eEmitem nota fiscal para pessoa jurídica?\u003c/summary\u003e\u003cp\u003eSim, emitimos nota fiscal para empresas e, em contratos recorrentes, é possível consolidar o faturamento mensalmente.\u003c/p\u003e\u003c/details\u003e\n\u003cdetails\u003e\u003csummary\u003eQuais regiões de Barueri vocês atendem para clientes corporativos?\u003c/summary\u003e\u003cp\u003eAtendemos empresas em todo Barueri, incluindo Alphaville e Tamboré, além de Carapicuíba, Jandira, Itapevi e Santana de Parnaíba.\u003c/p\u003e\u003c/details\u003e\n\u003cdetails\u003e\u003csummary\u003eComo solicito um orçamento para minha empresa?\u003c/summary\u003e\u003cp\u003eVocê pode solicitar pelo WhatsApp (11) 91839-0430 ou pela nossa plataforma de agendamento online, informando o tipo de imóvel e a necessidade.\u003c/p\u003e\u003c/details\u003e\n\u003c/div\u003e\n\n\u003cdiv class=\"mdr-author\"\u003e\n\u003cdiv class=\"foto\"\u003eME\u003c/div\u003e\n\u003cdiv\u003e\n\u003cstrong\u003eResponsável técnico: Mestre dos Reparos\u003c/strong\u003e\u003cbr\u003e\n\u003cspan style=\"font-size:0.9em;\"\u003eEngenharia Elétrica, Técnico em Eletrotécnica (SENAI), certificação NR-10. Mais de 15 anos de experiência em manutenção predial residencial, comercial e corporativa, atuando conforme NBR 5410 e NR-10 em Barueri e região.\u003c/span\u003e\n\u003c/div\u003e\n\u003c/div\u003e\n\n\u003cstyle\u003e\n.emp-carrossel{overflow:hidden;position:relative;margin-top:22px;-webkit-mask-image:linear-gradient(90deg,transparent,#000 6%,#000 94%,transparent);mask-image:linear-gradient(90deg,transparent,#000 6%,#000 94%,transparent)}\n.emp-trilha{display:flex;gap:14px;width:max-content;animation:empDeslizar 36s linear infinite}\n.emp-carrossel:hover .emp-trilha{animation-play-state:paused}\n@keyframes empDeslizar{from{transform:translateX(0)}to{transform:translateX(-50%)}}\n.emp-cliente{min-width:200px;background:#0b2a4a;border:2px solid #0b2a4a;border-top:5px solid #ffb300;border-radius:14px;padding:20px;text-align:center}\n.emp-cliente strong{display:block;color:#ffb300;font-size:19px;margin-bottom:6px}\n.emp-cliente span{font-size:14px;color:#dbe6f3}\n@media (prefers-reduced-motion: reduce){.emp-trilha{animation:none;flex-wrap:wrap;width:auto}}\n\u003c/style\u003e\n\u003cdiv class=\"mestre-box\" id=\"mestre-empresas-carrossel\"\u003e\n  \u003ch2\u003eEmpresas e organizações que já atendemos\u003c/h2\u003e\n  \u003cp\u003eNossos contratos corporativos incluem limpeza recorrente, manutenção predial preventiva e corretiva, adequações elétricas e hidráulicas e reparos em unidades administrativas e operacionais.\u003c/p\u003e\n  \u003cdiv class=\"emp-carrossel\"\u003e\n    \u003cdiv class=\"emp-trilha\"\u003e\n      \u003cdiv class=\"emp-cliente\"\u003e\u003cstrong\u003eCoca-Cola FEMSA\u003c/strong\u003e\u003cspan\u003eManutenção e limpeza\u003c/span\u003e\u003c/div\u003e\n      \u003cdiv class=\"emp-cliente\"\u003e\u003cstrong\u003eBradesco\u003c/strong\u003e\u003cspan\u003eManutenção predial e reparos\u003c/span\u003e\u003c/div\u003e\n      \u003cdiv class=\"emp-cliente\"\u003e\u003cstrong\u003eItaú\u003c/strong\u003e\u003cspan\u003eServiços de manutenção\u003c/span\u003e\u003c/div\u003e\n      \u003cdiv class=\"emp-cliente\"\u003e\u003cstrong\u003ePJ Bank\u003c/strong\u003e\u003cspan\u003eReparos e adequações\u003c/span\u003e\u003c/div\u003e\n      \u003cdiv class=\"emp-cliente\"\u003e\u003cstrong\u003eArmazena Armazéns\u003c/strong\u003e\u003cspan\u003eLimpeza e manutenção\u003c/span\u003e\u003c/div\u003e\n      \u003cdiv class=\"emp-cliente\"\u003e\u003cstrong\u003eMFA Transportes\u003c/strong\u003e\u003cspan\u003eManutenção de unidade\u003c/span\u003e\u003c/div\u003e\n      \u003cdiv class=\"emp-cliente\"\u003e\u003cstrong\u003eBureau Veritas\u003c/strong\u003e\u003cspan\u003eServiços prediais\u003c/span\u003e\u003c/div\u003e\n      \u003cdiv class=\"emp-cliente\"\u003e\u003cstrong\u003eCoca-Cola FEMSA\u003c/strong\u003e\u003cspan\u003eManutenção e limpeza\u003c/span\u003e\u003c/div\u003e\n      \u003cdiv class=\"emp-cliente\"\u003e\u003cstrong\u003eBradesco\u003c/strong\u003e\u003cspan\u003eManutenção predial e reparos\u003c/span\u003e\u003c/div\u003e\n      \u003cdiv class=\"emp-cliente\"\u003e\u003cstrong\u003eItaú\u003c/strong\u003e\u003cspan\u003eServiços de manutenção\u003c/span\u003e\u003c/div\u003e\n      \u003cdiv class=\"emp-cliente\"\u003e\u003cstrong\u003ePJ Bank\u003c/strong\u003e\u003cspan\u003eReparos e adequações\u003c/span\u003e\u003c/div\u003e\n      \u003cdiv class=\"emp-cliente\"\u003e\u003cstrong\u003eArmazena Armazéns\u003c/strong\u003e\u003cspan\u003eLimpeza e manutenção\u003c/span\u003e\u003c/div\u003e\n      \u003cdiv class=\"emp-cliente\"\u003e\u003cstrong\u003eMFA Transportes\u003c/strong\u003e\u003c